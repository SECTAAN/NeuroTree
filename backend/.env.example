# NeuroTree Backend — Environment Variables
# Salin file ini jadi .env lalu isi nilainya:
#   cp .env.example .env   (Mac/Linux)
#   copy .env.example .env  (Windows)
#
# File ini hanya untuk backend/. Untuk konfigurasi frontend (VITE_API_URL dll)
# lihat frontend/.env.example

# ── AI Mode ───────────────────────────────────────────────────────────────────
# True  = pakai mock data (tidak perlu Langflow)
# False = pakai Langflow live (wajib isi bagian LangFlow di bawah)
USE_MOCK_AI=False

# ── LangFlow ──────────────────────────────────────────────────────────────────
LANGFLOW_BASE_URL=http://localhost:7860
LANGFLOW_API_KEY=your-langflow-api-key-here

# Flow IDs — ambil dari URL setelah import flow di Langflow UI
# contoh URL: http://localhost:7860/flow/6c697ef9-xxxx-xxxx-xxxx-xxxxxxxxxxxx
LANGFLOW_FLOW_NT01=paste-nt01-flow-id-here
LANGFLOW_FLOW_NT02=paste-nt02-flow-id-here
LANGFLOW_FLOW_NT03=paste-nt03-flow-id-here
LANGFLOW_FLOW_NT04=paste-nt04-flow-id-here
LANGFLOW_FLOW_NT05=paste-nt05-flow-id-here

# ── Optional overrides (default values sudah aman untuk dev) ──────────────────
# DATABASE_URL=sqlite:///./neurotree.db
# RATE_LIMIT_QUIZ=20/minute
# RATE_LIMIT_INGEST=3/minute
# INGEST_MAX_CHARS=30000
