# Copy this file to .env and fill in your values
# NEVER commit .env to Git

# ── Application ───────────────────────────────────────────────────────────────
DEBUG=False

# ── Database (SQLite for MVP — path relative to backend/ directory) ───────────
DATABASE_URL=sqlite:///./neurotree.db

# ── CORS — comma-separated list of allowed frontend origins ───────────────────
# ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ── LangFlow ──────────────────────────────────────────────────────────────────
LANGFLOW_BASE_URL=http://localhost:7860
LANGFLOW_API_KEY=

# LangFlow Flow IDs
# These are the UUIDs of the five NeuroTree flows in your LangFlow workspace.
# Defaults below are the IDs from the tested environment — override if yours differ.
LANGFLOW_FLOW_NT01=fb98c393-ef54-4ccd-b768-e6539ef0fe6b
LANGFLOW_FLOW_NT02=92abecf5-f542-47ec-a287-08023c6c855e
LANGFLOW_FLOW_NT03=6d3c531f-6ba6-4249-b160-a6ba787e9033
LANGFLOW_FLOW_NT04=c559e197-7845-495f-9c21-0ebbefe9f58e
LANGFLOW_FLOW_NT05=cdc32939-0703-4d0c-948d-ae28b3878bed

# ── Mock Mode (Phase 11 anti-failure guard) ───────────────────────────────────
# Set to True to bypass LangFlow and return pre-built mock data.
# Use during demo if LangFlow is unreachable.
USE_MOCK_AI=False
